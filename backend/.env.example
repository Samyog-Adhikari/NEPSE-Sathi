# ── Server ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000

# ── Supabase ────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_min_32_chars
SUPABASE_JWT_SECRET=replace_with_jwt_secret_min_32_chars

# ── CORS (comma-separated) ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── AI providers (free tiers) ──────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
GROQ_API_KEY=your_groq_api_key
NVIDIA_NIM_API_KEY=your_nim_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# ── Market Data Provider ───────────────────────────────────────────────
MARKET_DATA_PROVIDER=scraper               # scraper | nepse_api
NEPSE_API_KEY=                             # leave blank until official access is granted
NEPSE_API_BASE_URL=                        # leave blank until official access is granted

# ── Scraping & Alerts ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ── Monitoring ──────────────────────────────────────────────────────────
SENTRY_DSN=https://your_sentry_dsn_here
